{
  "name": "taskrabbit-monorepo",
  "scripts": {
    "dev:APIGateway": "cd APIGateway && npm run dev",
    "dev:auth": "cd auth && npm run dev",
    "dev:user": "cd User && npm run dev",
    "dev:search": "cd SearchService && npm run dev",
     "dev:offer": "cd Offer-service && npm run dev",
    "all": "concurrently \"npm run dev:auth\" \"npm run dev:user\" \"npm run dev:APIGateway\" \"npm run dev:search\" \"npm run dev:offer\""
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.3",
    "jose": "^6.1.0",
    "jwt-decode": "^4.0.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "turbo": "^2.8.10",
    "zustand": "^5.0.11"
  }
}